{
  "name": "banking-pipeline",
  "version": "1.0.0",
  "description": "Multi-agent banking transaction processing pipeline",
  "author": "Serhii Kindyk",
  "main": "src/integrator.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "pipeline": "node src/integrator.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci --forceExit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "decimal.js": "^10.4.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    },
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
